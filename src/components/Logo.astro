---
// Vector redraw of the Dubai Smile wordmark (logo red + logo blue), rendered as an image so
// screen readers hear one name. Swap for the official vector logo when it is available.
import Icon from './Icon.astro';
import ui, { type Lang, homePath, useT } from '../i18n/ui';
interface Props { lang: Lang; class?: string }
const { lang, class: cls = '' } = Astro.props;
const t = useT(lang);
---
<a href={homePath(lang)} class:list={['inline-flex items-center gap-2 rounded-full', cls]} dir="ltr">
  <span class="grid size-8 place-items-center rounded-full bg-surface-accent text-logo-blue max-xs:hidden" aria-hidden="true">
    <Icon name="tooth" size={18} />
  </span>
  <svg
    role="img"
    aria-label={t(ui.brand.name)}
    viewBox="0 0 168 34"
    width="168"
    height="34"
    class="logo-mark h-auto w-[8.75rem] overflow-visible xs:w-[10.5rem]"
  >
    <text x="0" y="15" font-size="17" font-weight="700" letter-spacing="-0.34">
      <tspan class="fill-logo-red">DUBAI</tspan><tspan class="fill-logo-blue">SMILE</tspan>
    </text>
    <text x="0" y="30" font-size="11" font-weight="500" letter-spacing="0.2" class="fill-ink-2">Cosmetic &amp; Family Dentistry</text>
  </svg>
</a>

<style>
  .logo-mark {
    font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
  }
</style>
