---
// Phosphor icons (regular weight = 1.5px stroke at 24px), inlined at build time.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  weight?: 'regular' | 'bold' | 'fill';
  class?: string;
  label?: string;
}
const { name, size = 20, weight = 'regular', class: cls = '', label } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(
  `@phosphor-icons/core/assets/${weight}/${name}${weight === 'regular' ? '' : `-${weight}`}.svg`,
);
const raw = readFileSync(file, 'utf8');
const inner = raw.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class:list={['shrink-0', cls]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
