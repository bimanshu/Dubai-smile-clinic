---
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { reviews, reviewRole } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const [featured, ...rest] = [...reviews].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
const q = (s: string) => (lang === 'ar' ? `«${s}»` : `“${s}”`);
const role = (female: boolean) => t(female ? reviewRole.female : reviewRole.male);
---
<section class="section" aria-labelledby="reviews-title">
  <div class="container-page">
    <h2 id="reviews-title" class="text-title" data-reveal>{t(ui.reviews.title)}</h2>
    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12">
      <figure class="bezel lg:col-span-7" data-reveal>
        <div class="bezel-core flex h-full flex-col justify-between gap-12 p-7 sm:p-10 lg:p-12">
          <Icon name="quotes" size={40} weight="fill" class="text-ink-3" />
          <blockquote>
            <p class="max-w-[30ch] text-[clamp(1.5rem,1.2rem+1.1vw,2.125rem)] font-medium leading-[1.3] tracking-[-0.02em] text-ink">{q(t(featured.quote))}</p>
          </blockquote>
          <figcaption>
            <span class="block text-subheading">{t(featured.name)}</span>
            <span class="block text-body-sm text-ink-2">{role(featured.female)}</span>
          </figcaption>
        </div>
      </figure>
      <div class="grid gap-4 lg:col-span-5">
        {rest.map((r, i) => (
          <figure class="review-tile" data-reveal style={`--i:${i + 1}`}>
            <blockquote>
              <p class="text-lead text-ink">{q(t(r.quote))}</p>
            </blockquote>
            <figcaption class="mt-6">
              <span class="block text-subheading">{t(r.name)}</span>
              <span class="block text-body-sm text-ink-2">{role(r.female)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
    {t(ui.reviews.translated) && <p class="mt-6 text-caption text-ink-3">{t(ui.reviews.translated)}</p>}
  </div>
</section>

<style>
  .review-tile {
    border-radius: var(--radius-shell);
    padding: 1.75rem;
    background-color: var(--color-surface-muted);
    box-shadow: var(--shadow-ring);
  }
  @media (min-width: 40rem) {
    .review-tile {
      padding: 2.25rem;
    }
  }
  :global(html:lang(ar)) .review-tile p,
  :global(html:lang(ar)) blockquote p {
    letter-spacing: 0;
  }
</style>
