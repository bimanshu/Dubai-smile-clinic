---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { img } from '../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const w = ui.why;
---
<section class="section pt-0 lg:pt-0" aria-labelledby="why-title">
  <div class="container-page">
    <h2 id="why-title" class="max-w-[20ch] text-title" data-reveal>{t(w.title)}</h2>

    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12">
      <!-- Global team: the one image cell -->
      <article class="bezel lg:col-span-7 lg:row-span-2" data-reveal>
        <div class="bezel-core flex h-full flex-col">
          <div class="relative min-h-[18rem] flex-1 overflow-hidden bg-[#0097b2] lg:min-h-[22rem]">
            <Picture
              src={img('misc/team')}
              alt={t(w.global.alt)}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 44rem, 92vw"
              formats={['avif', 'webp']}
              loading="lazy"
              class="no-outline absolute inset-0 size-full object-cover object-[60%_12%]"
            />
          </div>
          <div class="p-6 sm:p-8">
            <h3 class="text-heading">{t(w.global.title)}</h3>
            <p class="mt-3 max-w-[44ch] text-body text-ink-2">{t(w.global.body)}</p>
          </div>
        </div>
      </article>

      <!-- Since 2002: tinted, large numerals -->
      <article class="bento-tile bg-surface-accent lg:col-span-5" data-reveal style="--i:1">
        <p class="tabular text-[clamp(3.5rem,2.6rem+3.2vw,5.5rem)] font-semibold leading-none tracking-[-0.05em] text-ink-on-accent-soft" aria-hidden="true">{t(w.years.value)}</p>
        <h3 class="mt-6 text-heading text-ink">{t(w.years.title)}</h3>
        <p class="mt-3 text-body text-ink-2">{t(w.years.body)}</p>
      </article>

      <!-- Multilingual: typographic visual -->
      <article class="bento-tile bg-surface lg:col-span-5" data-reveal style="--i:2">
        <p class="flex items-baseline gap-4 text-[clamp(2.75rem,2.2rem+2vw,4rem)] font-semibold leading-none text-ink-3" aria-hidden="true">
          <span lang="en" style="font-family: 'Geist', sans-serif">Aa</span>
          <span lang="ar" style="font-family: 'Plex Arabic', sans-serif">أب</span>
        </p>
        <h3 class="mt-6 text-heading">{t(w.language.title)}</h3>
        <p class="mt-3 text-body text-ink-2">{t(w.language.body)}</p>
      </article>

      <!-- In-house lab -->
      <article class="bento-tile bg-surface-muted lg:col-span-6" data-reveal style="--i:1">
        <span class="grid size-12 place-items-center rounded-full bg-surface text-ink shadow-[var(--shadow-ring)]">
          <Icon name="flask" size={22} />
        </span>
        <h3 class="mt-6 text-heading">{t(w.lab.title)}</h3>
        <p class="mt-3 max-w-[44ch] text-body text-ink-2">{t(w.lab.body)}</p>
      </article>

      <!-- Personal plans -->
      <article class="bento-tile bento-plans lg:col-span-6" data-reveal style="--i:2">
        <span class="grid size-12 place-items-center rounded-full bg-surface text-ink shadow-[var(--shadow-ring)]">
          <Icon name="calendar-check" size={22} />
        </span>
        <h3 class="mt-6 text-heading">{t(w.plans.title)}</h3>
        <p class="mt-3 max-w-[44ch] text-body text-ink-2">{t(w.plans.body)}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento-tile {
    border-radius: var(--radius-shell);
    padding: 1.75rem;
    box-shadow: var(--shadow-ring), var(--inset-highlight);
  }
  @media (min-width: 40rem) {
    .bento-tile {
      padding: 2.25rem;
    }
  }
  .bento-plans {
    background:
      radial-gradient(120% 140% at 100% 0%, oklch(0.835 0.094 234 / 0.28), transparent 55%),
      var(--color-surface);
  }
  :global(html[dir='rtl']) .bento-plans {
    background:
      radial-gradient(120% 140% at 0% 0%, oklch(0.835 0.094 234 / 0.28), transparent 55%),
      var(--color-surface);
  }
  @media (prefers-color-scheme: dark) {
    .bento-plans,
    :global(html[dir='rtl']) .bento-plans {
      background:
        radial-gradient(120% 140% at 100% 0%, oklch(0.44 0.089 234 / 0.35), transparent 55%),
        var(--color-surface);
    }
  }
</style>
