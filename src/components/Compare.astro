---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { img } from '../lib/images';

interface Props {
  lang: Lang;
  id: string;
  before: string;
  after: string;
  altBefore: string;
  altAfter: string;
  priority?: boolean;
  sizes: string;
  class?: string;
}
const { lang, id, before, after, altBefore, altAfter, priority = false, sizes, class: cls = '' } = Astro.props;
const t = useT(lang);
const loading = priority ? 'eager' : 'lazy';
const widths = [360, 480, 640, 800, 1080];
---
<figure class:list={['bezel', cls]} data-compare>
  <div
    class="bezel-core relative isolate aspect-[4/5] cursor-ew-resize touch-pan-y select-none overflow-hidden bg-[oklch(0.16_0.01_265)]"
    data-compare-stage
    dir="ltr"
  >
    <Picture
      src={img(after)}
      alt={altAfter}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class="no-outline pointer-events-none absolute inset-0 size-full object-cover"
      draggable="false"
    />
    <div class="absolute inset-0 will-change-[clip-path]" style="clip-path: inset(0 50% 0 0)" data-compare-before>
      <Picture
        src={img(before)}
        alt={altBefore}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={loading}
        decoding={priority ? 'sync' : 'async'}
        class="no-outline pointer-events-none absolute inset-0 size-full object-cover"
        draggable="false"
      />
    </div>

    <span class="compare-tag start-4" aria-hidden="true">{t(ui.compare.before)}</span>
    <span class="compare-tag end-4" aria-hidden="true">{t(ui.compare.after)}</span>

    <input
      id={`${id}-range`}
      class="compare-range peer"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={t(ui.compare.sliderLabel)}
      aria-valuetext="50%"
      data-compare-range
    />
    <div class="compare-handle" style="inset-inline-start: 50%" data-compare-handle aria-hidden="true">
      <span class="compare-line"></span>
      <span class="compare-knob">
        <Icon name="arrows-left-right" size={18} />
      </span>
    </div>
    <span class="compare-hint" data-compare-hint aria-hidden="true">{t(ui.compare.hint)}</span>
  </div>
  <figcaption class="sr-only">{t(ui.compare.label)}</figcaption>
</figure>

<style>
  .compare-tag {
    position: absolute;
    top: 1rem;
    z-index: 2;
    border-radius: 999px;
    padding: 0.3125rem 0.75rem;
    font-size: var(--text-caption);
    font-weight: 500;
    line-height: 1.3;
    color: oklch(0.985 0.004 262);
    background: oklch(0.2 0.02 265 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.14);
  }
  .compare-range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    pointer-events: none;
  }
  .compare-handle {
    position: absolute;
    inset-block: 0;
    z-index: 3;
    width: 0;
    pointer-events: none;
  }
  .compare-line {
    position: absolute;
    inset-block: 0;
    left: -1px;
    width: 2px;
    background: oklch(0.99 0 0 / 0.9);
    box-shadow: 0 0 12px oklch(0 0 0 / 0.25);
  }
  .compare-knob {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    translate: -50% -50%;
    color: oklch(0.235 0.042 267);
    background: oklch(0.99 0.002 262 / 0.92);
    box-shadow:
      0 0 0 1px oklch(1 0 0 / 0.6),
      0 8px 24px -6px oklch(0 0 0 / 0.45);
    transition: scale 160ms var(--ease-snappy);
  }
  .compare-range:focus-visible ~ .compare-handle .compare-knob {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  [data-dragging] .compare-knob {
    scale: 1.08;
  }
  .compare-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    z-index: 3;
    translate: -50% 0;
    border-radius: 999px;
    padding: 0.4375rem 0.875rem;
    font-size: var(--text-caption);
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    color: oklch(0.985 0.004 262);
    background: oklch(0.2 0.02 265 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.14);
    transition:
      opacity 250ms var(--ease-snappy),
      translate 250ms var(--ease-snappy);
  }
  [data-touched] .compare-hint {
    opacity: 0;
    translate: -50% 6px;
  }
  @media (prefers-reduced-transparency: reduce) {
    .compare-tag,
    .compare-hint {
      background: oklch(0.2 0.02 265);
      backdrop-filter: none;
    }
  }
</style>
