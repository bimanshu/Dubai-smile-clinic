---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { treatments, moreTreatments } from '../data/site';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="treatments" class="section" aria-labelledby="treatments-title">
  <div class="container-page">
    <div class="max-w-[40rem]" data-reveal>
      <h2 id="treatments-title" class="text-title">{t(ui.treatments.title)}</h2>
      <p class="mt-5 text-lead text-ink-2">{t(ui.treatments.sub)}</p>
    </div>

    <div class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-12 lg:gap-10" data-tabs data-reveal style="--i:1">
      <div class="min-w-0 lg:col-span-4">
        <div
          role="tablist"
          aria-label={t(ui.treatments.listLabel)}
          class="tablist"
          data-tablist
        >
          <span class="tab-indicator" aria-hidden="true" data-indicator></span>
          {treatments.map((tr, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tr.slug}`}
              aria-controls={`panel-${tr.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
              data-tab={tr.slug}
            >
              <span>{t(tr.name)}</span>
              <Icon name="caret-right" size={16} class="tab-caret flip-rtl" />
            </button>
          ))}
        </div>
      </div>

      <div class="min-w-0 lg:col-span-8">
        {treatments.map((tr, i) => (
          <div
            role="tabpanel"
            id={`panel-${tr.slug}`}
            aria-labelledby={`tab-${tr.slug}`}
            tabindex="0"
            class="panel bezel"
            hidden={i !== 0}
            data-panel={tr.slug}
          >
            <div class="bezel-core grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
              <Picture
                src={img(`services/${tr.image}`)}
                alt=""
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 26rem, (min-width: 768px) 45vw, 92vw"
                formats={['avif', 'webp']}
                loading="lazy"
                class="no-outline aspect-[4/3] size-full object-cover md:aspect-auto md:min-h-[26rem]"
              />
              <div class="flex flex-col p-6 sm:p-8 lg:p-10">
                <h3 class="text-heading">{t(tr.name)}</h3>
                <p class="mt-4 max-w-[46ch] text-body text-ink-2">{t(tr.summary)}</p>
                <p class="mt-7 text-body-sm font-medium text-ink">{t(ui.treatments.goodFor)}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {tr.goodFor.map((g) => <li class="chip">{t(g)}</li>)}
                </ul>
                <div class="mt-auto pt-8">
                  <a href="#book" class="btn btn-primary btn-has-icon" data-book-treatment={tr.slug}>
                    {t(ui.cta.book)}
                    <span class="sr-only">: {t(tr.name)}</span>
                    <span class="btn-icon"><Icon name="arrow-right" size={18} class="flip-rtl" /></span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 lg:mt-24">
      <h3 class="text-subheading" data-reveal>{t(ui.treatments.also)}</h3>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {moreTreatments.map((m, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href="#book" class="more-card" data-book-treatment={m.slug}>
              <span class="flex items-center justify-between gap-4">
                <span class="grid size-10 place-items-center rounded-full bg-surface-accent text-ink-on-accent-soft">
                  <Icon name={m.icon} size={20} />
                </span>
                <Icon name="arrow-right" size={18} class="more-arrow flip-rtl text-ink-3" />
              </span>
              <span class="mt-5 block text-subheading">{t(m.name)}</span>
              <span class="mt-2 block text-body-sm text-ink-2">{t(m.summary)}</span>
              <span class="sr-only">{t(ui.treatments.askAbout)} {t(m.name)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .tablist {
    position: relative;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-inline: -1rem;
    padding: 0.25rem 1rem 0.5rem;
    scroll-padding-inline: 1rem;
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 40rem) {
    .tablist {
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }
  }
  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    border-radius: 999px;
    padding-inline: 1.125rem;
    scroll-snap-align: start;
    font-weight: 500;
    font-size: var(--text-body);
    white-space: nowrap;
    color: var(--color-ink-2);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-ring);
    cursor: pointer;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 160ms var(--ease-snappy);
  }
  .tab:active {
    transform: scale(0.96);
  }
  .tab[aria-selected='true'] {
    color: var(--color-on-action);
    background-color: var(--color-action);
    box-shadow: none;
  }
  .tab :global(.tab-caret) {
    display: none;
  }
  .tab-indicator {
    display: none;
  }

  @media (min-width: 64rem) {
    .tablist {
      flex-direction: column;
      gap: 0.25rem;
      overflow: visible;
      margin: 0;
      padding: 0;
    }
    .tab {
      width: 100%;
      min-height: 3.5rem;
      padding-inline: 1.375rem 1.125rem;
      background-color: transparent;
      box-shadow: none;
    }
    .tab[aria-selected='true'] {
      color: var(--color-ink);
      background-color: transparent;
    }
    .tab :global(.tab-caret) {
      display: block;
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity 200ms ease,
        transform 250ms var(--ease-snappy);
    }
    :global(html[dir='rtl']) .tab :global(.tab-caret) {
      transform: scaleX(-1) translateX(-4px);
    }
    .tab[aria-selected='true'] :global(.tab-caret) {
      opacity: 1;
      transform: none;
    }
    :global(html[dir='rtl']) .tab[aria-selected='true'] :global(.tab-caret) {
      transform: scaleX(-1);
    }
    .tab-indicator {
      position: absolute;
      inset-inline: 0;
      top: 0;
      display: block;
      height: 3.5rem;
      border-radius: 999px;
      background-color: var(--color-surface);
      box-shadow:
        var(--shadow-ring),
        var(--inset-highlight),
        0 8px 20px -10px oklch(0.235 0.042 267 / 0.25);
      transition: transform 300ms var(--ease-move);
    }
    @media (hover: hover) and (pointer: fine) {
      .tab:not([aria-selected='true']):hover {
        color: var(--color-ink);
        background-color: var(--color-surface-muted);
      }
    }
  }

  /* Panel swap: quick fade and lift, interruptible */
  .panel {
    transition:
      opacity 240ms var(--ease-snappy),
      transform 240ms var(--ease-snappy);
  }
  @starting-style {
    .panel {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition: opacity 150ms ease;
    }
    @starting-style {
      .panel {
        transform: none;
      }
    }
    .tab-indicator {
      transition: none;
    }
  }

  /* Without JavaScript the tabs can't switch, so show every treatment in a stack */
  :global(.no-js) .tablist {
    display: none;
  }
  :global(.no-js) .panel[hidden] {
    display: block !important;
    margin-top: 1rem;
  }

  .more-card {
    display: block;
    height: 100%;
    border-radius: var(--radius-shell);
    padding: 1.5rem;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-ring), var(--inset-highlight);
    transition:
      box-shadow 250ms ease,
      transform 160ms var(--ease-snappy);
  }
  .more-card:active {
    transform: scale(0.98);
  }
  .more-card :global(.more-arrow) {
    transition: transform 250ms var(--ease-snappy);
  }
  @media (hover: hover) and (pointer: fine) {
    .more-card:hover {
      box-shadow:
        var(--shadow-ring),
        var(--inset-highlight),
        var(--shadow-soft);
    }
    .more-card:hover :global(.more-arrow) {
      transform: translateX(3px);
    }
    :global(html[dir='rtl']) .more-card:hover :global(.more-arrow) {
      transform: scaleX(-1) translateX(3px);
    }
  }
</style>
