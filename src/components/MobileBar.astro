---
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { clinics, telHref } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<div class="mobile-bar md:hidden" data-mobile-bar inert>
  <div class="mobile-bar-inner">
    <button type="button" class="btn btn-quiet flex-1" data-call-open aria-haspopup="dialog" aria-controls="call-sheet">
      <Icon name="phone" size={18} />
      {t(ui.cta.call)}
    </button>
    <a href="#book" class="btn btn-primary flex-[1.7]">{t(ui.cta.book)}</a>
  </div>
</div>

<dialog id="call-sheet" class="sheet" aria-labelledby="call-sheet-title" data-call-sheet>
  <div class="sheet-handle" aria-hidden="true"></div>
  <div class="flex items-center justify-between gap-4">
    <h2 id="call-sheet-title" class="text-heading">{t(ui.nav.callUs)}</h2>
    <button type="button" class="sheet-close" data-call-close>
      <Icon name="x" size={18} />
      <span class="sr-only">{t(ui.cta.close)}</span>
    </button>
  </div>
  <ul class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-2">
    {clinics.map((c) => (
      <li>
        <a href={telHref(c.phone)} class="sheet-row">
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="font-medium text-ink"><span class="sr-only">{t(ui.clinics.callAria, { name: t(c.name) })}: </span><span aria-hidden="true">{t(c.name)}</span></span>
            <span class="truncate text-body-sm text-ink-2" aria-hidden="true">{t(c.address)}</span>
          </span>
          <span class="flex shrink-0 items-center gap-2 text-body-sm font-medium text-ink">
            <bdi dir="ltr" class="tabular">{c.phone}</bdi>
            <span class="grid size-9 place-items-center rounded-full bg-accent text-on-accent"><Icon name="phone" size={16} /></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</dialog>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 30;
    transform: translateY(calc(100% + 1.5rem));
    opacity: 0;
    transition:
      transform 400ms var(--ease-snappy),
      opacity 300ms var(--ease-snappy);
  }
  .mobile-bar[data-visible] {
    transform: none;
    opacity: 1;
  }
  .mobile-bar-inner {
    display: flex;
    gap: 0.375rem;
    border-radius: 999px;
    padding: 0.375rem;
    background-color: var(--color-glass-strong);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow:
      var(--shadow-ring),
      var(--inset-highlight),
      var(--shadow-float);
  }
  @media (prefers-reduced-transparency: reduce) {
    .mobile-bar-inner {
      background-color: var(--color-surface);
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-bar {
      transform: none;
      transition: opacity 200ms ease;
    }
  }

  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 36rem;
    max-height: 85dvh;
    margin: 0 auto;
    border: 0;
    border-radius: 1.75rem 1.75rem 0 0;
    padding: 0.75rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    color: var(--color-ink);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-float);
    overscroll-behavior: contain;
    transform: translateY(100%);
    transition:
      transform 450ms var(--ease-drawer),
      display 450ms allow-discrete,
      overlay 450ms allow-discrete;
  }
  .sheet[open] {
    transform: none;
  }
  @starting-style {
    .sheet[open] {
      transform: translateY(100%);
    }
  }
  .sheet::backdrop {
    background-color: oklch(0.18 0.022 265 / 0);
    transition:
      background-color 300ms ease,
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }
  .sheet[open]::backdrop {
    background-color: oklch(0.18 0.022 265 / 0.4);
  }
  @starting-style {
    .sheet[open]::backdrop {
      background-color: oklch(0.18 0.022 265 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transform: none;
      opacity: 0;
      transition:
        opacity 200ms ease,
        display 200ms allow-discrete,
        overlay 200ms allow-discrete;
    }
    .sheet[open] {
      opacity: 1;
    }
    @starting-style {
      .sheet[open] {
        transform: none;
        opacity: 0;
      }
    }
  }
  .sheet-handle {
    width: 2.5rem;
    height: 0.25rem;
    margin: 0 auto 1rem;
    border-radius: 999px;
    background-color: var(--color-line-strong);
    opacity: 0.5;
  }
  .sheet-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background-color: var(--color-surface-muted);
    cursor: pointer;
  }
  .sheet-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: var(--radius-card);
    padding: 0.875rem 0.875rem 0.875rem 1rem;
    background-color: var(--color-surface-muted);
  }
</style>
