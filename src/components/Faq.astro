---
import Icon from './Icon.astro';
import ui, { type Lang, useT } from '../i18n/ui';
import { faqs, clinics, telHref } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const main = clinics[0];
---
<section id="faq" class="section bg-surface-muted" aria-labelledby="faq-title">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-32" data-reveal>
        <p class="eyebrow">
          <Icon name="chat-circle-text" size={16} />
          {t(ui.faq.eyebrow)}
        </p>
        <h2 id="faq-title" class="mt-6 text-title">{t(ui.faq.title)}</h2>
        <p class="mt-5 text-lead text-ink-2">{t(ui.faq.sub)}</p>
        <a href={telHref(main.phone)} class="btn btn-secondary btn-has-icon mt-8">
          <span class="flex items-center gap-2">
            <span>{t(ui.cta.call)}<span class="sr-only"> {t(ui.clinics.callSr, { name: t(main.name) })}</span></span>
            <bdi dir="ltr" class="tabular">{main.phone}</bdi>
          </span>
          <span class="btn-icon"><Icon name="phone" size={18} /></span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-8" data-reveal style="--i:1">
      {faqs.map((f, i) => (
        <details name="faq" class="faq" open={i === 0}>
          <summary class="faq-q">
            <span>{t(f.q)}</span>
            <span class="faq-icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="faq-a">
            <p class="max-w-[62ch] pb-7 text-body text-ink-2">{t(f.a)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    border-bottom: 1px solid var(--color-line);
    interpolate-size: allow-keywords;
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3rem;
    padding-block: 1.375rem;
    list-style: none;
    cursor: pointer;
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    font-weight: 500;
    color: var(--color-ink);
    border-radius: 0.5rem;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-ring);
    color: var(--color-ink);
    transition:
      transform 250ms var(--ease-snappy),
      background-color 200ms ease,
      color 200ms ease;
  }
  .faq[open] .faq-icon {
    transform: rotate(45deg);
    background-color: var(--color-action);
    color: var(--color-on-action);
  }
  @media (hover: hover) and (pointer: fine) {
    .faq-q:hover .faq-icon {
      box-shadow: var(--shadow-ring), 0 4px 12px -6px oklch(0.235 0.042 267 / 0.3);
    }
  }
  .faq::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 250ms var(--ease-snappy),
      opacity 250ms var(--ease-snappy),
      content-visibility 250ms allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq::details-content {
      transition-property: opacity, content-visibility;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
